<!DOCTYPE html>
<html>
  <head>
    <meta charset="utf-8" />
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Fira+Code:wght@300..700&family=Outfit:wght@100..900&display=swap" rel="stylesheet">
    <link rel="stylesheet" type="text/css" href="dep/normalize.css/normalize.css" />
    <link rel="stylesheet" type="text/css" href="dep/Font-Awesome/css/font-awesome.css" />
    <link rel="stylesheet" type="text/css" href="style.css" />
    <title>{{.Title}}</title>
    <meta name="author" content="{{.Basics.Name}}">
    <meta name="description" content="{{.Basics.Summary}}">
  </head>
  <body lang="en">
    <div class="page page--intro">
      <div id="grid-container">
        <!-- HEADER ROW -->
        <header id="title">
          <h1>{{.Basics.Name.First}} <strong>{{.Basics.Name.Nick}}</strong> {{.Basics.Name.Second}}</h1>
          <span class="subtitle"></span>
          <p class="summary">{{.Basics.Summary}}</p>
          
          <!-- Contact Info Moved Here -->
          <div id="contact-header">
             <ul>
              <li><i class="contact fa fa-envelope"></i><a href="mailto:{{.Basics.Email}}">{{.Basics.Email}}</a></li>
              {{- if not .Basics.Phone.Hidden}}
              <li><i class="contact fa fa-phone"></i>{{.Basics.Phone}}</li>
              {{- end -}}
              {{- if not .Basics.Skype.Hidden}}
              <li><i class="contact fa fa-skype"></i><a href="skype:{{.Basics.Skype.ID}}?chat">{{.Basics.Skype.Email}}</a></li>
              {{- end -}}
              <li><i class="contact fa fa-globe"></i><a href="https://{{.Basics.Website}}">{{.Basics.Website}}</a></li>
              <li><i class="contact fa fa-github"></i><a href="https://{{.Basics.Github}}">{{.Basics.Github}}</a></li>
              <li><i class="contact fa fa-linkedin"></i><a href="https://www.linkedin.com/in/{{.Basics.Linkedin}}">{{.Basics.Linkedin}}</a></li>
             </ul>
          </div>
        </header>
        
        <!-- PORTFOLIO ROW -->
        {{- if .Portfolio}}
        <section id="portfolio-section" class="main-block">
          <div class="portfolio-grid">
          {{- range .Portfolio}}
          {{- if not .Hidden}}
          <section class="blocks portfolio-item">
            <div class="details">
              <header>
                <h3>{{.Name}}</h3>
                {{- if .URL}}
                <span class="project-url"><a href="https://{{.URL}}">{{.URL}}</a></span>
                {{- end}}
              </header>
              <div class="summary">
                {{.Summary}}
              </div>
              {{- if .Metrics}}
              <div class="metrics">
                {{- range .Metrics}}
                <span class="metric">
                  {{- if .Label}}
                  <span class="metric-label">{{.Label}}</span>
                  {{- end}}
                  {{- if .Value}}
                  <span class="metric-value">{{.Value}}</span>
                  {{- end}}
                  {{- if .Change}}
                  <span class="metric-change">{{.Change}}</span>
                  {{- end}}
                </span>
                {{- end}}
              </div>
              {{- end}}
              {{- if .Items}}
              <div class="portfolio-items">
                {{- range .Items}}
                <div class="portfolio-subitem" id="portfolio-item-{{.Title | slugify}}">
                   <div class="subitem-header">
                      <span class="subitem-title">
                        {{- if .URL -}}
                        <a href="{{.URL}}" class="title-link">
                          {{.Title}}
                          <i class="fa fa-external-link link-icon" aria-hidden="true"></i>
                        </a>
                        {{- else -}}
                        {{.Title}}
                        {{- end -}}
                      </span>
                      <span class="subitem-tag">{{.Tag}}</span>
                   </div>
                   <div class="subitem-text">{{.Text | markdown}}</div>
                   {{- if .Metrics}}
                   <div class="subitem-metrics">
                     {{- range .Metrics}}
                     <span class="metric">
                       {{- if .Label}}
                       <span class="metric-label">{{.Label}}</span>
                       {{- end}}
                       {{- if .Value}}
                       <span class="metric-value">{{.Value}}</span>
                       {{- end}}
                       {{- if .Change}}
                       <span class="metric-change">{{.Change}}</span>
                       {{- end}}
                     </span>
                     {{- end}}
                   </div>
                   {{- end}}
                </div>
                {{- end}}
              </div>
              {{- else if .Highlights}}
              <ul>
                {{- range .Highlights}}
                <li>{{. | markdown}}</li>
                {{- end}}
              </ul>
              {{- end}}
            </div>
          </section>
          {{- end}}
          {{- end}}
          </div>
        </section>
        {{- end}}
      </div>
    </div>

    <div class="page page--body">
      <div id="grid-container">
        <!-- MAIN CONTENT ROW (Split) -->
        <div id="main-content-row">
            <div id="limbo">
            </div>
             <section id="main">
              <section class="main-block">
                <h2>
                  <i class="fa fa-briefcase"></i>{{.Headings.Work}}
                </h2>
                {{- range .Work}}
                {{- if not .Hidden}}
                <section class="blocks">
                  <div class="date">
                    <span>{{.EndDate}}</span><span>{{.StartDate}}</span>
                  </div>
                  <div class="decorator"></div>
                  <div class="details">
                    <header>
                      <h3>{{.Position}}</h3>
                      <span class="place">{{.Company}}</span>
                      <span class="location">{{.Location}}</span>
                    </header>
                    <div>
                      <ul>
                        {{- range .Highlights}}
                        {{- if not .Hidden}}
                        <li>{{. | markdown}}</li>
                        {{- end -}}
                        {{- end -}}
                        
                        {{- if .RefItems}}
                        {{- range .RefItems}}
                        <li class="portfolio-ref">See project <a href="#portfolio-item-{{. | slugify}}">{{.}}</a></li>
                        {{- end}}
                        {{- end}}
                      </ul>
                    </div>
                  </div>
                </section>
                {{- end -}}
                {{- end -}}
              </section>
              <section class="main-block">
                <h2>
                  <i class="fa fa-graduation-cap"></i>{{.Headings.Education}}
                </h2>
                {{- range .Education}}
                {{- if not .Hidden}}
                <section class="blocks">
                  <div class="date">
                    <span>{{.EndDate}}</span><span>{{.StartDate}}</span>
                  </div>
                  <div class="decorator"></div>
                  <div class="details">
                    <header>
                      <h3>{{.StudyType}}</h3>
                      <span class="place">{{.Institution}}</span>
                      {{- if ne .Location ""}}
                      <span class="location">{{.Location}}</span>
                      {{- end -}}
                    </header>
                    <div>
                      <ul>
                        {{- range .Highlights}}
                        {{- if not .Hidden}}
                        <li>{{. | markdown}}</li>
                        {{- end -}}
                        {{- end -}}
                      </ul>
                    </div>
                  </div>
                </section>
                {{- end -}}
                {{- end -}}
              </section>
            </section>
            
            <aside id="sidebar">
              <div id="sidebar-adjust">
              <div class="side-block" id="skills">
                <h1>
                  {{.Headings.Skills}}
                </h1>
                {{- range .Skills}}
                {{- if not .Hidden}}
                <div class="skill-group">
                  <div class="skill-name">{{.Name}}</div>
                  <ul class="skill-items">
                    {{- range .Keywords}}
                    <li>{{.}}</li>
                    {{- end -}}
                  </ul>
                </div>
                {{- end -}}
                {{- end -}}
              </div>
              <div class="side-block" id="projects">
                <h1>
                  {{.Headings.Projects}}
                </h1>
                {{- range .Projects}}
                {{- if not .Hidden}}
                <div class="sidebar-project">
                  <div class="project-title">
                    {{- if .URL -}}
                    <a href="{{.URL}}" class="title-link">
                      {{.Name}} <i class="fa fa-external-link link-icon" aria-hidden="true"></i>
                    </a>
                    {{- else -}}
                    {{.Name}}
                    {{- end -}}
                  </div>
                  {{- if .Highlights}}
                  <ul class="project-highlights">
                    {{- range .Highlights}}
                    {{- if not .Hidden}}
                    <li>{{. | markdown}}</li>
                    {{- end -}}
                    {{- end -}}
                  </ul>
                  {{- end}}
                </div>
                {{- end}}
                {{- end}}

              </div>
              {{- if .Awards}}
              <div class="side-block" id="awards">
                <h1>
                  {{.Headings.Awards}}
                </h1>
                {{- range .Awards}}
                {{- if not .Hidden}}
                <div class="sidebar-project">
                  <div class="project-title">
                    {{.Title}}
                  </div>
                  {{- if .Date}}
                  <div class="project-url">{{.Date}}</div>
                  {{- end}}
                  {{- if .Summary}}
                  <ul class="project-highlights">
                    <li>{{.Summary | markdown}}</li>
                  </ul>
                  {{- end}}
                </div>
                {{- end}}
                {{- end}}
              </div>
              {{- end}}
              <div id="sidebar-qrcode">
                <span class="label">Digital Copy</span>
                <img src="dep/qrcode.png" alt="QR Code">
              </div>
              </div>
            </aside>
        </div>
      </div>
    </div>
  </body>
</html>
